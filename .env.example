# ── API Keys ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# Apify — used for Reddit scraping (no Reddit credentials needed)
# Sign up free at https://apify.com → Settings → API & Integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Apify Reddit actor settings
APIFY_REDDIT_ACTOR=trudax/reddit-scraper
APIFY_REDDIT_MAX_ITEMS=2000

YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Twitter/X (optional — leave blank to skip this source)
TWITTER_BEARER_TOKEN=

# ── Data Paths ────────────────────────────────────────────
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
VECTOR_STORE_DIR=data/vector_store

# ── Relevance Filter Thresholds ───────────────────────────
# Minimum cosine similarity for a chunk to be considered retrieval-related
RELEVANCE_THRESHOLD=0.45

# Minimum character length for a raw record to be ingested
MIN_CHUNK_LENGTH=30

# ── Clustering ────────────────────────────────────────────
HDBSCAN_MIN_CLUSTER_SIZE=10

# ── Date Range ────────────────────────────────────────────
# How far back to scrape (in days). Default: 3 years = 1095 days
SCRAPE_LOOKBACK_DAYS=1095

# ── Groq Model Selection ──────────────────────────────────
# Heavy analysis (extraction, cluster labeling, gap mapping)
GROQ_MODEL_ANALYSIS=llama-3.3-70b-versatile
# Lightweight classification (memory cues, gap types, behavior tags)
GROQ_MODEL_CLASSIFY=llama-3.1-8b-instant

# ── LLM Call Settings ────────────────────────────────────
LLM_MAX_RETRIES=5
LLM_BATCH_SIZE=50
LLM_MAX_CONCURRENT=5

# ── Embedding Model ───────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=100
